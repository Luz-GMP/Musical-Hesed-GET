    {"id":"scene-06","version":4,"status":"review","durationSec":106,"durationStatus":"provisional-15-to-20s-per-visual-cue","description":"Reconstrução da Cena 6 usando os seis quadros originais como gravura em papel e três recortes espaciais mascarados. Cada quadro entra como página ilustrada, recebe panorâmica com rastro e troca por uma transição de tinta; Q06 sustenta a passagem para a Cena 7.","layers":[{"id":"far-plane","role":"background","method":"paper-ink-spatial-mask"},{"id":"mid-plane","role":"intermediate","method":"paper-ink-spatial-mask"},{"id":"near-plane","role":"foreground","method":"paper-ink-spatial-mask"},{"id":"vector-cordel-overlay","role":"ink-linework","assetPath":"cena-06-v04/assets/mm12-cordel-overlay.svg"}],"segments":[{"id":"mm12-q01-segment","assetId":"mm12-q01","startSec":0,"durationSec":18,"transition":"paper-sweep"},{"id":"mm12-q02-segment","assetId":"mm12-q02","startSec":18,"durationSec":17,"transition":"cutout-wipe"},{"id":"mm12-q03-segment","assetId":"mm12-q03","startSec":35,"durationSec":16,"transition":"ink-reveal"},{"id":"mm12-q04-segment","assetId":"mm12-q04","startSec":51,"durationSec":17,"transition":"camera-pan"},{"id":"mm12-q05-segment","assetId":"mm12-q05","startSec":68,"durationSec":18,"transition":"fold-shadow"},{"id":"mm12-q06-segment","assetId":"mm12-q06","startSec":86,"durationSec":20,"transition":"quiet-hold","holdIntoNextScene":true}],"audio":{"voice":[],"music":[],"ambience":[],"sfx":[]},"approvals":[]}
